# 钥匙 1 · 腾讯云 API 密钥（与 TRTC 应用同一站点）
#   国内站：https://console.cloud.tencent.com/cam/capi?utm_term=cam%E5%AF%86%E9%92%A5-%E5%9B%BD%E5%86%85&utm_campaign=skill&_channel_track_key=hTRQ0ctd
#   海外站：https://console.tencentcloud.com/cam/capi?utm_term=cam%E5%AF%86%E9%92%A5&utm_campaign=skill&_channel_track_key=zb44We6s
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_REGION=ap-guangzhou

# 钥匙 2 · TRTC 应用凭证
#   国内站：https://console.cloud.tencent.com/trtc/app?utm_campaign=skill&_channel_track_key=lDTHxeje
#   海外站：https://console.trtc.io?utm_campaign=Agent-skills-general&_channel_track_key=tR91l0wy
# 应用所在站点：intl = 海外站，cn = 国内站
TRTC_REGION=intl
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=

# 钥匙 3 · LLM 密钥（OpenAI 兼容协议）
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

PORT=8020
