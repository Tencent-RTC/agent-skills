# ==========================================================================
# trtc-ai-oral-coach Skill — ignore runtime artifacts & secrets
# These are generated when the app is run/deployed and must NEVER ship
# with the Skill. The Skill only distributes source: SKILL.md, capabilities/,
# scenarios/, scripts/, auto_adapters/, references/, README*, triggers.yaml,
# start.sh, and each capability's .env.example.
# ==========================================================================

# --- Secrets (never commit real keys) ---
# The runtime .env holds the 3 keys; only .env.example ships.
.env
.env.local
**/.env
**/.env.local
!**/.env.example

# --- Python virtual environment / runtime ---
.venv/
venv/
env/

# --- Python bytecode caches ---
__pycache__/
*.py[cod]
*.pyo

# --- Path A deployed UI (regenerated at runtime from scenarios/speaking-coach/ui) ---
ai-oral-coach-demo/

# --- Runtime logs / start output ---
.coach-start.log
.coach-start.err
/tmp/coach-start.log

# --- HTTPS dev certs (generated by start.sh --https) ---
certs/

# --- Local working notes (not part of the Skill) ---
improvement-plan.md

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
