# =============================================================
# TRTC Voice AI Starter Kit — Environment Variables
# Copy this file to .env and fill in your values.
# Keys 1 and 2 come from the same Tencent Cloud account;
# Key 3 comes from your own LLM provider.
# =============================================================

# ---- Key 1: TRTC ----------------------------------------
# Create Application → select "Conversational AI" type
#   China site:         https://console.cloud.tencent.com/trtc/app?utm_campaign=skill&_channel_track_key=lDTHxeje
#   International site: https://console.trtc.io?utm_campaign=Agent-skills-general&_channel_track_key=tR91l0wy
# Doc: https://trtc.io/document/69002
# Use SDKSecretKey (server-side), NOT STSecretKey (client-side).
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=

# ---- Key 2: Tencent Cloud API ---------------------------
#   China site:         https://console.cloud.tencent.com/cam/capi?utm_term=cam%E5%AF%86%E9%92%A5-%E5%9B%BD%E5%86%85&utm_campaign=skill&_channel_track_key=hTRQ0ctd
#   International site: https://console.tencentcloud.com/cam/capi?utm_term=cam%E5%AF%86%E9%92%A5&utm_campaign=skill&_channel_track_key=zb44We6s
# Same Tencent Cloud login — no separate registration needed.
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=

# StartAIConversation only supports these 5 regions (doc: https://trtc.io/document/64963.md).
# The API host is derived from the region, because the two Tencent Cloud sites
# are separate and an account exists on only one of them:
#   ap-guangzhou     (China Mainland)      → trtc.tencentcloudapi.com
#   ap-singapore     (Southeast Asia)      → trtc.intl.tencentcloudapi.com
#   ap-tokyo         (Northeast Asia)      → trtc.intl.tencentcloudapi.com
#   na-ashburn       (East US)             → trtc.intl.tencentcloudapi.com
#   na-siliconvalley (West US)             → trtc.intl.tencentcloudapi.com
# Pick the region of the TRTC application you created.
TENCENT_CLOUD_REGION=ap-guangzhou

# Override the derived API host. Leave empty unless you were given a specific
# endpoint — a mismatched host fails with an authentication error, not a 404.
# TENCENT_CLOUD_ENDPOINT=

# ---- Key 3: LLM -----------------------------------------
# Any OpenAI-compatible provider — use the one you already have.
# Fill in all three values from the same provider.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# Examples (LLM_API_URL / LLM_MODEL):
#   Hunyuan:  https://hunyuan.cloud.tencent.com/openai/v1/chat/completions   hunyuan-2.0-instruct-20251111
#   OpenAI:   https://api.openai.com/v1/chat/completions                     gpt-4o-mini
#   DeepSeek: https://api.deepseek.com/chat/completions                      deepseek-chat
# More providers: references/provider-config.md in the skill.
# Note: Anthropic Claude API is NOT OpenAI-compatible — use a proxy or switch-provider for other options.

# ---- STT (Speech-to-Text) --------------------------------
# Provider: tencent (default) | azure | deepgram | soniox
# Switching provider docs: https://trtc.io/document/68336
STT_PROVIDER=tencent
STT_LANGUAGE=en             # language the USER speaks

# Language the AI agent responds in (used for bilingual transcription).
# Defaults to STT_LANGUAGE if not set. Override when AI speaks a different language.
# Examples: en | zh | ja | ko | fr
# AGENT_LANGUAGE=en

# Target language for bilingual translation. Must be set explicitly.
# Example: AI speaks English, user wants Japanese subtitles → BILINGUAL_TARGET_LANG=ja
# BILINGUAL_TARGET_LANG=

# Required when STT_PROVIDER is azure / deepgram / soniox:
# STT_API_KEY=           # azure: SubscriptionKey  deepgram/soniox: ApiKey
# STT_AZURE_REGION=      # azure only (e.g. eastus)
# STT_MODEL=             # deepgram: nova-3  soniox: stt-rt-v4

# ---- TTS (Text-to-Speech) --------------------------------
# Provider: flow (default) | minimax | azure | elevenlabs | cartesia | inworld | custom
# Switching provider docs: https://trtc.io/document/68340
TTS_PROVIDER=flow

# Voice ID for the selected TTS provider. Flow voices: https://trtc.io/document/79682
# flow: optional — if unset, STT_LANGUAGE=zh → female-kefu-xiaoyue, anything else → v-female-p9Xy7Q1L
# minimax / azure / elevenlabs / cartesia / inworld: REQUIRED, and must be that provider's
#   own voice ID — /agent/start returns 400 TTS_VOICE_ID_REQUIRED if it is missing
# TTS_VOICE_ID=v-female-p9Xy7Q1L

# Required when TTS_PROVIDER is minimax / elevenlabs / cartesia / inworld / custom:
# TTS_API_KEY=
# TTS_API_URL=           # minimax / custom only
# TTS_MINIMAX_GROUP_ID=  # minimax only
# TTS_AZURE_SUBSCRIPTION_KEY=  # azure only
# TTS_AZURE_REGION=      # azure only (e.g. eastus)

# ---- Agent behavior --------------------------------------
# The reply is spoken by TTS and shown verbatim as subtitles, so keep the
# "no markdown / no lists" rules if you rewrite this. Delete the line to use
# the built-in default (same text, see server/src/env.ts).
AGENT_SYSTEM_PROMPT=You are a helpful voice assistant in a real-time spoken conversation. Everything you write is spoken aloud, so write only plain spoken sentences: no markdown, bold, headings, bullet points, numbered lists, emoji or URLs. When listing things, mention at most three, connect them naturally ("first..., then..., and finally..."), and ask if the user wants to hear more. Keep each reply to one to three short sentences. Write numbers, dates, prices and phone numbers the way they are spoken. Reply in the language the user speaks.
AGENT_GREETING=Hello, how can I help you today?
AGENT_MAX_IDLE_TIME=60

# ---- Server ----------------------------------------------
SERVER_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

# ---- UserSig issuance (GET /userSig) ---------------------
# How long an issued room credential stays valid, in seconds.
# Default 7200 (2h). Keep it short: whoever holds a UserSig can enter rooms
# as that user until it expires. Max 86400.
# USERSIG_EXPIRE_SECONDS=7200
#
# When set, GET /userSig requires `Authorization: Bearer <token>`.
# ⚠️ Leaving this empty means ANYONE who can reach the server can mint room
# credentials for ANY userId, on your bill. That is acceptable only while the
# server is bound to localhost. The server logs a warning on every startup
# while it is empty.
# Do NOT put this value in the web app — a browser-side secret is public.
# Generate one with:  openssl rand -hex 32
# USERSIG_AUTH_TOKEN=

# ---- Webhook (optional, for production) ------------------
# Register this URL in TRTC console to receive agent lifecycle events.
# For local development, use ngrok: ngrok http 3000
# Then register: https://<xxx>.ngrok.io/webhook/agent-events
#
# This must be the SAME key you entered in the TRTC console callback config.
# Console constraint: up to 32 characters, letters and digits only.
# Contract: Sign header = base64(hmac-sha256(key, raw body)) — doc 68331.
#
# Without this key every delivery is REJECTED (fail-closed), because the
# endpoint writes to disk and must not be open to the internet.
WEBHOOK_SIGNING_SECRET=

# Accept unsigned webhook deliveries. Local testing only — never on a public URL.
# WEBHOOK_ALLOW_UNSIGNED=false

# Size cap for server/data/conversations.jsonl (bytes). Events are dropped with
# a warning once the file reaches it, so a flood cannot fill the disk.
# WEBHOOK_LOG_MAX_BYTES=10485760
