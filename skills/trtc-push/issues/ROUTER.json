{
  "$schema_note": "Lightweight TIMPush issue router. Keep this file small: route only, no solution body. Rule types: card / flow / workflow (have target or workflow_id) and link (link-only: no target, `doc_key` points to an entry in DOC-LINKS.md).",
  "version": "2026-10-12",
  "routing_policy": {
    "purpose": "Best-effort candidate routing, not an exhaustive decision tree.",
    "order": [
      "Use high-priority exact error-code or keyword routes first.",
      "Use low-priority generic platform routes when the user gives a broad symptom.",
      "If no route matches, ask fallback.question once and rerun routing with the new facts."
    ],
    "no_match_is_not_failure": true
  },
